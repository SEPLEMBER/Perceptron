<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================================================================== -->
    <!-- БАЗОВАЯ ТЕМА ПРИЛОЖЕНИЯ                                              -->
    <!-- ==================================================================== -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:colorBackground">#0A0A0A</item>
        
        <item name="android:textColor">#EEFFFF</item>
        <item name="android:textColorHint">#546E7A</item>
        
        <item name="colorAccent">#00E5FF</item>
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorPrimaryDark">#0A0A0A</item>

        <item name="android:colorLongPressedHighlight">#3300E5FF</item>
        <item name="android:colorActivatedHighlight">#3300E5FF</item>
        
        <item name="android:textColorHighlight">#4400E5FF</item>
        
        <item name="android:textCursorDrawable">@null</item>
        
        <item name="colorControlHighlight">#4400E5FF</item>
    </style>

    <!-- ==================================================================== -->
    <!-- ПРОЗРАЧНАЯ ТЕМА                                                      -->
    <!-- ==================================================================== -->
    <style name="AppTheme.Transparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ==================================================================== -->
    <!-- ТЕМА ДЛЯ ТЁМНЫХ ДИАЛОГОВ (общая для всех диалогов)                   -->
    <!-- ==================================================================== -->
    <style name="DarkDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <!-- Единый тёмный фон для всего диалога (#0A0A0A) -->
        <item name="android:background">#0A0A0A</item>
        <item name="android:colorBackground">#0A0A0A</item>
        <item name="colorBackgroundFloating">#0A0A0A</item>
        <item name="android:windowBackground">#0A0A0A</item>
        
        <!-- Текст внутри диалога -->
        <item name="android:textColorPrimary">#EEFFFF</item>
        <item name="android:textColorSecondary">#A9B7C6</item>
        <item name="android:textColorAlertDialogListItem">#EEFFFF</item>
        
        <!-- Цвет заголовка диалога -->
        <item name="android:textColorPrimaryInverse">#EEFFFF</item>
        
        <!-- Акценты и контролы -->
        <item name="colorAccent">#00E5FF</item>
        <item name="colorControlActivated">#00E5FF</item>
        <item name="colorControlNormal">#546E7A</item>
        
        <item name="android:textColorHighlight">#4400E5FF</item>
        <item name="colorControlHighlight">#4400E5FF</item>

        <!-- Стили кнопок -->
        <item name="buttonBarPositiveButtonStyle">@style/DarkDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DarkDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/DarkDialogButton.Neutral</item>
    </style>

    <!-- Положительная кнопка: ФИОЛЕТОВЫЙ (цвет val/var/const) -->
    <style name="DarkDialogButton.Positive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#C792EA</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Отрицательная кнопка: ПРИГЛУШЕННЫЙ КОРИЧНЕВЫЙ (холодный тон) -->
    <style name="DarkDialogButton.Negative" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#7A6652</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Нейтральная кнопка -->
    <style name="DarkDialogButton.Neutral" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ==================================================================== -->
    <!-- СТИЛЬ ДЛЯ OVERLAY РЕЗУЛЬТАТОВ                                        -->
    <!-- ==================================================================== -->
    <style name="OverlayResultTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
    </style>
    
    <!-- ==================================================================== -->
    <!-- ДОПОЛНИТЕЛЬНЫЕ ЦВЕТОВЫЕ РЕСУРСЫ                                      -->
    <!-- ==================================================================== -->
    <color name="neon_cyan">#00E5FF</color>
    <color name="neon_green">#A8FF60</color>
    <color name="neon_red">#FF3355</color>
    <color name="neon_purple">#C792EA</color>
    <color name="brown_muted">#7A6652</color>
    <color name="neon_cyan_transparent">#4400E5FF</color>
    <color name="neon_green_transparent">#44A8FF60</color>
    <color name="neon_red_transparent">#44FF3355</color>
    
    <color name="background_primary">#0A0A0A</color>
    <color name="background_secondary">#0F0F0F</color>
    <color name="background_dialog">#0A0A0A</color>
    <color name="background_statusbar">#151515</color>
    
    <color name="divider_subtle">#1F1F1F</color>
    <color name="divider_normal">#2C2F33</color>
    
    <color name="text_primary">#EEFFFF</color>
    <color name="text_secondary">#A9B7C6</color>
    <color name="text_hint">#4A4A4A</color>
    <color name="text_hint_cyan">#005F6B</color>
</resources>
