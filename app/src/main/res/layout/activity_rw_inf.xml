<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#120A0A"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROWAN"
        android:textColor="#FF5252"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:shadowColor="#FF5252"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ВСТРОЕННЫЙ VM ДВИЖОК"
        android:textColor="#FF80AB"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:layout_marginBottom="48dp" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Версия: 1.0.0"
        android:textColor="#FFAB40"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Мощный, тьюринг-полный, изолированный скриптовый язык, разработанный для Android. Поддерживает эмуляцию троичной логики, интерпретацию байт-кода и генетические алгоритмы."
        android:textColor="#FFF0F0"
        android:textSize="14sp"
        android:lineSpacingExtra="6dp"
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="ВЕРНУТЬСЯ В РЕДАКТОР"
        android:textColor="#120A0A"
        android:backgroundTint="#FF5252"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
